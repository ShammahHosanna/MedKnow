# ── MedKnow environment variables ─────────────────────────────────────────────
# Copy to .env.local for local dev, or set them in Vercel → Project → Settings
# → Environment Variables. Keys are SERVER-SIDE ONLY: never prefix with
# NEXT_PUBLIC_ and never commit real values.

# Primary AI provider: "gemini" (default) | "openai" | "mock" (no API call,
# deterministic output — useful for local dev and CI).
LLM_PROVIDER=gemini

# Server-only API keys. One is required for live analysis.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Model names — check current availability of the free tier on day 1 and pin
# the exact model id here (defaults are sensible but may change upstream).
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_MODEL=gpt-4o-mini

# Optional secondary provider used as automatic fallback when the primary one
# returns 429/5xx. Leave empty to disable.
FALLBACK_PROVIDER=
FALLBACK_API_KEY=
FALLBACK_MODEL=

# Basic in-memory rate limit per IP (best-effort on serverless).
RATE_LIMIT_PER_MIN=10

# Max server-side wait for the AI provider, in ms.
REQUEST_TIMEOUT_MS=25000
